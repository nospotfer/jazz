# Supabase
NEXT_PUBLIC_SUPABASE_URL='https://your-project.supabase.co'
NEXT_PUBLIC_SUPABASE_ANON_KEY='your-anon-key'
# Optional but recommended for OAuth redirects (no trailing slash)
# Use your deployed domain in production, e.g. https://lms.seudominio.com
NEXT_PUBLIC_APP_URL='http://localhost:3000'
# Server-side canonical app URL used by callback routes (no trailing slash)
# In production, set this to your public app domain.
APP_URL='http://localhost:3000'
SUPABASE_SERVICE_ROLE_KEY='your-service-role-key'
SUPABASE_STORAGE_BUCKET='PDFs - Cultura del Jazz'
SIGNED_URL_TTL_SECONDS='900'

# Database - Session Pooler (required for IPv6-only Supabase + serverless platforms)
# Get this from Supabase Dashboard -> Settings -> Database -> Connection Pooling -> Session
DATABASE_URL='postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres'

# Note: If your Supabase database is IPv6-only (most are), you cannot use direct connection
# from Vercel or most local machines. Use the Session Pooler and run migrations via Supabase SQL Editor.

# Payments provider selector
PAYMENT_PROVIDER='dodo'

# Dodo Payments
# Use test_mode for local/staging and live_mode in production
DODO_ENVIRONMENT='test_mode'
DODO_API_BASE_URL='https://test.dodopayments.com'
DODO_PAYMENTS_API_KEY='your_dodo_api_key'
DODO_PAYMENTS_WEBHOOK_SECRET='your_dodo_webhook_secret'
DODO_BUSINESS_ID='bus_xxx'
DODO_PRODUCT_ID='pdt_xxx'
# Anti-replay window in seconds for webhook timestamp validation
DODO_WEBHOOK_REPLAY_WINDOW_SECONDS='300'

# Optional local synthetic checkout (bypasses provider in localhost when set to 1)
ENABLE_LOCAL_TEST_CHECKOUT='0'

# Messaging (Resend + inbound webhook)
PROFESSOR_EMAIL='professor@yourdomain.com'
RESEND_API_KEY='re_xxx'
RESEND_FROM_EMAIL='Jazz LMS <no-reply@yourdomain.com>'
INBOUND_EMAIL_WEBHOOK_SECRET='your-inbound-webhook-secret'

# Mux (signed playback)
MUX_SIGNING_KEY_ID='your_mux_signing_key_id'
MUX_SIGNING_PRIVATE_KEY='your_mux_signing_private_key_or_base64_pem'

# Admin
ADMIN_OWNER_EMAIL='admin@neurofactory.net'
ADMIN_EMAIL='your-admin-email'
ADMIN_USER_ID='admin-1'
ADMIN_ROLE='SUPER_ADMIN'

# Vercel deployment protection bypass for automation/testing
VERCEL_AUTOMATION_BYPASS_SECRET='your_vercel_automation_bypass_secret'

# Third-party analytics / heatmap (client-side, public area only, excluded from /admin/*)
# OpenReplay (client tracker)
NEXT_PUBLIC_OPENREPLAY_ENABLED='false'
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=''
# URL del panel para deep links desde /admin/heatmap (ej. https://app.openreplay.com/16692)
NEXT_PUBLIC_OPENREPLAY_DASHBOARD_URL=''

# OpenReplay REST API (server-side) — necesario para mostrar métricas reales en /admin/heatmap
# Crea la API Key en OpenReplay → Preferences → Account → API Key
OPENREPLAY_API_KEY=''
OPENREPLAY_PROJECT_ID=''
# Opcional: URL base de la API. Default: https://api.openreplay.com
OPENREPLAY_API_URL=''
