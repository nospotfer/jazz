generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LanguageCode {
  es
  en
  fr
  pt
}

enum AttachmentKind {
  CLASS
  AUXILIARY
}

enum VoucherType {
  FREE_ACCESS
  DISCOUNT_PERCENT
  DISCOUNT_FIXED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  role          String   @default("USER") // USER | SUPER_ADMIN | COURSE_ADMIN | CONTENT_CREATOR | MODERATOR
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Course {
  id          String     @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  price       Float?
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chapters    Chapter[]
  purchases   Purchase[]
  vouchers    VoucherCode[]
  translations CourseTranslation[]
}

model Chapter {
  id          String   @id @default(uuid())
  title       String
  description String?
  position    Int
  isPublished Boolean  @default(false)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  translations ChapterTranslation[]

  @@unique([courseId, position])
}

model Lesson {
  id              String           @id @default(uuid())
  title           String
  description     String?
  videoUrl        String?
  position        Int
  isPublished     Boolean          @default(false)
  chapterId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  attachments     Attachment[]
  chapter         Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  userProgress    UserProgress[]
  lessonPurchases LessonPurchase[]
  translations    LessonTranslation[]

  @@unique([chapterId, position])
}

model CourseTranslation {
  id          String       @id @default(uuid())
  courseId    String
  language    LanguageCode
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, language])
  @@index([language])
}

model ChapterTranslation {
  id          String       @id @default(uuid())
  chapterId   String
  language    LanguageCode
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, language])
  @@index([language])
}

model LessonTranslation {
  id          String       @id @default(uuid())
  lessonId    String
  language    LanguageCode
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, language])
  @@index([language])
}

model Attachment {
  id          String         @id @default(uuid())
  name        String
  url         String
  lessonId    String
  language    LanguageCode   @default(es)
  kind        AttachmentKind @default(CLASS)
  documentKey String         @default("class-note")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, language, documentKey])
  @@index([lessonId])
  @@index([language])
  @@index([kind])
}

model Purchase {
  id             String           @id @default(uuid())
  userId         String
  courseId       String
  voucherId      String?
  originalPrice  Float?
  finalPrice     Float?
  discountAmount Float?
  stripeSessionId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  voucher        VoucherCode?     @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  discount       DiscountApplied?
  redemption     VoucherRedemption?

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([voucherId])
  @@index([stripeSessionId])
}

model VoucherBatch {
  id         String        @id @default(uuid())
  name       String?
  codePrefix String?
  quantity   Int           @default(0)
  createdBy  String?
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  vouchers   VoucherCode[]

  @@index([createdAt])
}

model VoucherCode {
  id              String              @id @default(uuid())
  code            String              @unique
  type            VoucherType
  discountPercent Float?
  discountAmount  Float?
  minOrderValue   Float?
  courseId        String?
  batchId         String?
  maxUses         Int?
  currentUses     Int                 @default(0)
  maxUsesPerUser  Int                 @default(1)
  isActive        Boolean             @default(true)
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  course          Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch           VoucherBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  redemptions     VoucherRedemption[]
  discountsApplied DiscountApplied[]
  purchases       Purchase[]

  @@index([code])
  @@index([isActive, expiresAt])
  @@index([courseId])
  @@index([batchId])
}

model VoucherRedemption {
  id           String      @id @default(uuid())
  voucherId    String
  userId       String
  purchaseId   String?     @unique
  redeemedAt   DateTime    @default(now())
  voucher      VoucherCode @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  purchase     Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([voucherId, userId])
  @@index([userId])
  @@index([voucherId])
  @@index([purchaseId])
}

model DiscountApplied {
  id             String      @id @default(uuid())
  purchaseId     String      @unique
  voucherId      String?
  originalPrice  Float
  discountAmount Float
  finalPrice     Float
  createdAt      DateTime    @default(now())
  purchase       Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  voucher        VoucherCode? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([voucherId])
}

model UserProgress {
  id               String   @id @default(uuid())
  userId           String
  lessonId         String
  isCompleted      Boolean  @default(false)
  progressPercent  Int      @default(0)
  minutesRemaining Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model LessonPurchase {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model LessonNote {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  lessonId  String
  content   String   @default("")
  isBold    Boolean  @default(false)
  isItalic  Boolean  @default(false)
  fontSize  Int      @default(13)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([courseId])
}
