generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LanguageCode {
  es
  en
  fr
  pt
}

enum QuizMedalTier {
  NONE
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  role          String   @default("USER") // USER | SUPER_ADMIN | COURSE_ADMIN | CONTENT_CREATOR | MODERATOR
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Course {
  id          String     @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  price       Float?
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chapters    Chapter[]
  purchases   Purchase[]
  translations CourseTranslation[]
}

model Chapter {
  id          String   @id @default(uuid())
  title       String
  description String?
  position    Int
  isPublished Boolean  @default(false)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  translations ChapterTranslation[]

  @@unique([courseId, position])
}

model Lesson {
  id              String           @id @default(uuid())
  title           String
  description     String?
  videoUrl        String?
  position        Int
  isPublished     Boolean          @default(false)
  chapterId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  attachments     Attachment[]
  chapter         Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  quizQuestions   LessonQuizQuestion[]
  quizAttempts    LessonQuizAttempt[]
  quizSummaries   LessonQuizSummary[]
  userProgress    UserProgress[]
  lessonPurchases LessonPurchase[]
  translations    LessonTranslation[]

  @@unique([chapterId, position])
}

model CourseTranslation {
  id          String       @id @default(uuid())
  courseId    String
  language    LanguageCode
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, language])
  @@index([language])
}

model ChapterTranslation {
  id          String       @id @default(uuid())
  chapterId   String
  language    LanguageCode
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, language])
  @@index([language])
}

model LessonTranslation {
  id          String       @id @default(uuid())
  lessonId    String
  language    LanguageCode
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, language])
  @@index([language])
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model UserProgress {
  id               String   @id @default(uuid())
  userId           String
  lessonId         String
  isCompleted      Boolean  @default(false)
  progressPercent  Int      @default(0)
  minutesRemaining Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model LessonPurchase {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model LessonNote {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  lessonId  String
  content   String   @default("")
  isBold    Boolean  @default(false)
  isItalic  Boolean  @default(false)
  fontSize  Int      @default(13)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([courseId])
}

model LessonQuizQuestion {
  id             String                   @id @default(uuid())
  lessonId       String
  prompt         String
  explanation    String?
  sourceLabel    String?
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  lesson         Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options        LessonQuizOption[]
  attemptAnswers LessonQuizAttemptAnswer[]

  @@index([lessonId, isActive])
}

model LessonQuizOption {
  id         String                    @id @default(uuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean                   @default(false)
  position   Int
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  question   LessonQuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedBy LessonQuizAttemptAnswer[] @relation("SelectedQuizOption")

  @@unique([questionId, position])
  @@unique([questionId, label])
  @@index([questionId])
}

model LessonQuizAttempt {
  id            String                   @id @default(uuid())
  userId        String
  lessonId      String
  scorePercent  Int?
  correctCount  Int                      @default(0)
  questionCount Int                      @default(12)
  medal         QuizMedalTier            @default(NONE)
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  lesson        Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers       LessonQuizAttemptAnswer[]

  @@index([userId, lessonId, createdAt])
  @@index([lessonId, completedAt])
}

model LessonQuizAttemptAnswer {
  id               String             @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  orderIndex       Int
  isCorrect        Boolean?
  answeredAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  attempt          LessonQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         LessonQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   LessonQuizOption?  @relation("SelectedQuizOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, orderIndex])
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model LessonQuizSummary {
  id               String        @id @default(uuid())
  userId           String
  lessonId         String
  bestAttemptId    String?
  bestScorePercent Int           @default(0)
  bestCorrectCount Int           @default(0)
  bestMedal        QuizMedalTier @default(NONE)
  totalAttempts    Int           @default(0)
  lastAttemptAt    DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lesson           Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([bestAttemptId])
}
