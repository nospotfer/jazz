# Copy to .payments-e2e.env (ignored). Use a separate test database and Dodo test
# business. Never use production accounts, payments, or stored browser sessions.
PAYMENT_PROVIDER=dodo
DODO_ENVIRONMENT=test_mode
PAYMENTS_E2E_REAL_ENABLED=0
PAYMENTS_E2E_STORAGE_STATE=.auth/payments-test.json
PAYMENTS_E2E_COURSE_ID=your_test_course_id
PAYMENTS_E2E_EXPECT_HOST=test.checkout.dodopayments.com
PAYMENTS_E2E_METHODS=card
PAYMENTS_E2E_VOUCHER_CODES=your_test_voucher
E2E_LOGIN_EMAIL=student@example.test
E2E_LOGIN_PASSWORD=your_test_password
E2E_LOGIN_USER_ID=your_test_user_id
E2E_LOGIN_COURSE_TITLE=La Cultura del Jazz
